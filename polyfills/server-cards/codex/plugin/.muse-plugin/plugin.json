{
  "schemaVersion": 1,
  "name": "mcp-server-cards",
  "displayName": "MCP Server Cards",
  "version": "0.1.1",
  "description": "MCP Server Cards (SEP-2127) for Muse Code: find the MCP servers a domain publishes, check their Server Cards, and get the muse mcp add command that adds the one you pick.",
  "compat": {
    "source": "native",
    "manifestDir": ".muse-plugin"
  },
  "capabilities": {
    "skills": [
      {
        "id": "server-cards",
        "path": "muse/skills/server-cards/SKILL.md",
        "enabledDefault": true
      }
    ],
    "mcpServers": [
      {
        "id": "mcp-server-cards",
        "transport": "stdio",
        "command": ["node", "muse/dist/server.mjs"]
      }
    ]
  }
}
