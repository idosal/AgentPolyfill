{
  "schemaVersion": 1,
  "name": "mcp-event-monitor",
  "displayName": "MCP Events monitor",
  "version": "0.2.0",
  "description": "Receive one immediate alert or collect subscribed events with your next message.",
  "capabilities": {
    "mcpServers": [
      {
        "id": "events",
        "transport": "stdio",
        "command": [
          "node",
          "dist/server.mjs"
        ]
      },
      {
        "id": "mcp-events",
        "transport": "stdio",
        "command": [
          "node",
          "dist/inbox.mjs"
        ]
      }
    ],
    "skills": [
      {
        "id": "mcp-events-guide",
        "path": "skills/events/SKILL.md",
        "enabledDefault": true
      }
    ],
    "hooks": [
      {
        "id": "user-prompt-submit",
        "event": "UserPromptSubmit",
        "command": [
          "node",
          "dist/user-prompt-submit.mjs"
        ],
        "timeoutMs": 5000
      }
    ]
  },
  "compat": {
    "source": "native",
    "manifestDir": ".muse-plugin"
  }
}
