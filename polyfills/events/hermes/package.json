{
  "name": "mcp-events-hermes",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "A Hermes Agent plugin that adds MCP Events (SEP-3415) by webhook, push and poll: Hermes can watch events on your MCP servers, and an event wakes the idle session that asked for it.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test --no-warnings \"test/*-test.ts\"",
    "typecheck": "tsc --noEmit -p .",
    "build": "node build.mjs",
    "interop": "node --no-warnings test/interop/run.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "0.28.2",
    "typescript": "^5.9.3"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "Ido Salomon",
    "url": "https://github.com/idosal"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/idosal/AgentPolyfill.git",
    "directory": "polyfills/events/hermes"
  }
}
