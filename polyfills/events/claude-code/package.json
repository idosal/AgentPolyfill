{
  "name": "mcp-events",
  "private": true,
  "version": "0.7.1",
  "type": "module",
  "description": "A Claude Code mod that adds MCP Events (SEP-3415) support: Claude can watch events on your MCP servers and react when they happen.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test --no-warnings \"test/*-test.ts\"",
    "typecheck": "tsc --noEmit -p .",
    "build": "node build.mjs",
    "interop": "cd test/interop && npm install --silent && cd ../.. && node --no-warnings test/interop/run.ts",
    "conformance": "node --no-warnings test/conformance-driver.ts --suite",
    "test:mod": "claude plugin test mod",
    "perf": "node build.mjs && PERF_RUNTIME='node --no-warnings' node --no-warnings test/perf.ts",
    "typecheck:interop": "tsc --noEmit -p test/interop",
    "validate": "claude plugin validate mod"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "0.28.2",
    "fast-check": "^4.11.0",
    "typescript": "^5.9.3"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "Ido Salomon",
    "url": "https://github.com/idosal"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/idosal/AgentPolyfill.git",
    "directory": "polyfills/events/claude-code"
  }
}
