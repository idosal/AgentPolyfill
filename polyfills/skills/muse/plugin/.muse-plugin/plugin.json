{
  "schemaVersion": 1,
  "name": "mcp-skill-reference",
  "displayName": "MCP Skills reference",
  "version": "0.2.0",
  "description": "List publisher skills in Muse and read their verified guides and supporting files.",
  "capabilities": {
    "mcpServers": [
      {
        "id": "skills",
        "transport": "stdio",
        "command": [
          "node",
          "dist/server.mjs"
        ]
      }
    ],
    "skills": [
      {
        "id": "mcp-skills-guide",
        "path": "skills/skills/SKILL.md",
        "enabledDefault": true
      }
    ]
  },
  "compat": {
    "source": "native",
    "manifestDir": ".muse-plugin"
  }
}
