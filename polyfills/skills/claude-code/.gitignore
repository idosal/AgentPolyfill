node_modules/
*.log
.DS_Store
# Claude Code writes its API types beside a mod it loads from a folder.
/mod/.claude-plugin/types/
# Per-run state of tests and live runs.
/state/
/.test-state/
# A live run's raw terminal recording and its project folder stay on the machine that made it;
# the pictures of the screen at each step (*.txt) are kept as evidence.
/live/runs/*/cast.jsonl
/live/runs/*/raw.bin
/live/runs/*/project/
/live/runs/*/state/
/live/runs/*/server.log
