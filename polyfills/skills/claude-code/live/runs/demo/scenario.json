{
 "cmd": [
  "claude",
  "--plugin-dir",
  "<repo>/mod",
  "--setting-sources",
  "project",
  "--permission-mode",
  "default"
 ],
 "cwd": "<repo>/live/runs/demo/project",
 "env": {
  "MCP_SKILLS_SOURCES": "project",
  "MCP_SKILLS_STATE": "<repo>/live/runs/demo/state"
 },
 "cols": 88,
 "rows": 28,
 "steps": [
  {
   "wait": "trust this folder|❯",
   "timeout": 40
  },
  {
   "when": "trust this folder",
   "steps": [
    {
     "sleep": 1.5
    },
    {
     "key": "down",
     "after": 0.8
    },
    {
     "key": "enter",
     "after": 3
    }
   ]
  },
  {
   "wait": "❯",
   "timeout": 60
  },
  {
   "sleep": 8
  },
  {
   "keys": "/mcp-skills forget",
   "delay": 0.04
  },
  {
   "sleep": 0.7
  },
  {
   "key": "enter",
   "after": 2
  },
  {
   "wait": "approval",
   "timeout": 30
  },
  {
   "sleep": 1
  },
  {
   "keys": "/clear",
   "delay": 0.04
  },
  {
   "sleep": 0.7
  },
  {
   "key": "enter",
   "after": 2
  },
  {
   "sleep": 4
  },
  {
   "snap": "00-start"
  },
  {
   "keys": "/mcp-skills",
   "delay": 0.09
  },
  {
   "sleep": 0.7
  },
  {
   "key": "enter",
   "after": 2
  },
  {
   "wait": "Have Claude use one",
   "timeout": 60
  },
  {
   "sleep": 3
  },
  {
   "snap": "01-skills"
  },
  {
   "keys": "Which GGUF quantization should I use to run a 7B model on a 16 GB Mac?",
   "delay": 0.06
  },
  {
   "sleep": 0.7
  },
  {
   "key": "enter",
   "after": 2
  },
  {
   "wait": "Do you want to proceed",
   "timeout": 180
  },
  {
   "sleep": 3
  },
  {
   "snap": "02-approval"
  },
  {
   "key": "enter",
   "after": 2
  },
  {
   "wait": "Which GGUF(.|\\n)*· done |Q[4-8]_K(.|\\n)*· done ",
   "timeout": 300
  },
  {
   "sleep": 6
  },
  {
   "snap": "03-answer"
  },
  {
   "key": "ctrl-c",
   "after": 0.5
  },
  {
   "key": "ctrl-c",
   "after": 0.5
  },
  {
   "key": "ctrl-c",
   "after": 2
  }
 ]
}