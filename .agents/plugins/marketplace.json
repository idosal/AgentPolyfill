{
  "name": "agent-polyfill",
  "owner": {
    "name": "Ido Salomon",
    "url": "https://github.com/idosal"
  },
  "interface": {
    "displayName": "AgentPolyfill"
  },
  "plugins": [
    {
      "name": "mcp-events",
      "source": {
        "source": "local",
