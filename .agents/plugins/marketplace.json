        "installation": "AVAILABLE"
      },
      "category": "Developer Tools"
    },
    {
      "name": "mcp-server-cards",
      "source": {
        "source": "local",
        "path": "./polyfills/server-cards/codex/plugin"
      },
      "policy": {
        "installation": "AVAILABLE"
      },
      "category": "Developer Tools"
    },
    {
      "name": "mcp-tasks",
      "source": {
        "source": "local",
        "path": "./polyfills/tasks/codex/plugin"
      },
      "policy": {
        "installation": "AVAILABLE"
      },
      "category": "Developer Tools"
    },
    {
      "name": "ard-discovery",
      "source": {
        "source": "local",
        "path": "./polyfills/ard/codex/plugin"
      },
      "policy": {
        "installation": "AVAILABLE"
      },
      "category": "Developer Tools"
