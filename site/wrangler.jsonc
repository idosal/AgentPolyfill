// The AgentPolyfill website, served as static assets by Cloudflare Workers.
// Pages and assets are answered from the VitePress build without running any
// code. The small Worker in worker/index.js runs only for the videos
// (/media/*.mp4), to answer the byte ranges Safari asks for when it plays one.
// Posters and everything else stay plain static assets: they are free and
// unlimited, while a request that runs the Worker counts against the plan's
// daily limit, and past it gets a 429 instead of the file.
//
//   npm run build                                  build into .vitepress/dist
//   npx wrangler@4.167.0 dev                       serve the build locally, as Workers will
//   npx wrangler@4.167.0 deploy                    publish (npm run deploy builds first)
//
// www.agentpolyfill.com redirects to agentpolyfill.com through a Worker of its
// own, in www-redirect/.
{
  "$schema": "https://unpkg.com/wrangler@4.167.0/config-schema.json",
  "name": "agentpolyfill-site",
  "main": "./worker/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./.vitepress/dist",
    "binding": "ASSETS",
    "run_worker_first": ["/media/*.mp4"],
    // VitePress writes 404.html; unknown paths get it with a 404 status.
    "not_found_handling": "404-page",
    // VitePress (cleanUrls) writes guide/events.html and links /guide/events.
    "html_handling": "auto-trailing-slash"
  },
  "workers_dev": true,
  "preview_urls": false,

  // The custom domain. Cloudflare keeps its DNS record and certificate.
  "routes": [{ "pattern": "agentpolyfill.com", "custom_domain": true }]
}
