  <entry>
    <id>tag:github.com,2008:Repository/426659329/create-cloudflare@2.75.1</id>
    <updated>2026-11-23T19:23:50Z</updated>
    <link rel="alternate" type="text/html" href="https://github.com/cloudflare/workers-sdk/releases/tag/create-cloudflare%402.75.1"/>
    <title>create-cloudflare@2.75.1</title>
    <content type="html">&lt;h3&gt;Patch Changes&lt;/h3&gt;
